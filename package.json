{
  "name": "@doscientos/verifactu",
  "version": "0.1.24",
  "description": "Framework-agnostic Verifactu (AEAT) invoice submission, SIF hash chain and QR generation for Node.js.",
  "keywords": [
    "aeat",
    "invoice",
    "sif",
    "spain",
    "tax",
    "veri-factu",
    "verifactu"
  ],
  "homepage": "https://github.com/doscientos-es/verifactu#readme",
  "bugs": {
    "url": "https://github.com/doscientos-es/verifactu/issues"
  },
  "license": "MIT",
  "author": "Doscientos <dev@doscientos.es>",
  "repository": {
    "type": "git",
    "url": "https://github.com/doscientos-es/verifactu.git"
  },
  "files": [
    "dist",
    "docs",
    "config.example.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js",
      "require": "./dist/durable.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./nif": {
      "types": "./dist/nif.d.ts",
      "import": "./dist/nif.js",
      "require": "./dist/nif.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-schemas.mjs && node scripts/verify-runtime-import.mjs",
    "check:schemas": "node scripts/check-aeat-schemas.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build",
    "format": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --write .",
    "format:check": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "release:check": "pnpm quality && pnpm build && npm pack --dry-run"
  },
  "dependencies": {
    "@richhouse83/xsd-validator": "1.0.0",
    "date-fns-tz": "^3.2.0",
    "fast-xml-parser": "^5.7.0",
    "libxmljs2": "0.37.0",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@doscientos/configs": "^0.1.5",
    "@types/node": "^22.10.5",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@9.15.2"
}
